        }
      ]
    },
    {
      "id": "claim_dc4003ce6e4741a389a8958801eca40b",
      "statement": "The creation commit is excluded from the update search so a page published and never edited carries no date-modified at all, and any derived date at or below the published date is dropped rather than displayed.",
