    {
      "id": "claim_f5cdb539bc9047aa9ccdce3c47412a4a",
      "statement": "Dirty-path detection uses git diff --name-only instead of parsing git status porcelain output, because stripping the command output removed the leading status columns and shifted every first path by one character, causing changed files to be missed.",
      "evidence": [
        {
          "resource": "repo://_tools/sync_dates.py#L38-L48",
          "version": "repo-lines-v1:sha256:a113d1d9744023c3fad64e110885d5e4ba8131f70d5fc4676f79e8bc0a4699da:"
        }
      ]
    },
    {
      "id": "claim_6b8b208b35784c70b1d3884f35e77437",
      "statement": "sync_dates.py runs in two modes distinguished only by --check: the default rewrites files and returns 0, while --check leaves files untouched and returns 1 when any date would change, making it usable as a gate.",
      "evidence": [
        {
          "resource": "repo://_tools/sync_dates.py#L91-L138",
          "version": "repo-lines-v1:sha256:9ec104f1f1f2b39f5519cb49a61c25e8389934613b04f66c1c93739990378ee6:"
        }
