  "claims": [
    {
      "id": "claim_1cfcdf2d649e47719e92ee803f343364",
      "statement": "sync_dates.py derives each review's date-modified from git rather than from hand-maintained frontmatter, using today's date when the working tree has content changes and the last content-changing commit date otherwise.",
      "evidence": [
        {
          "resource": "repo://_tools/sync_dates.py#L1-L30",
          "version": "repo-lines-v1:sha256:16e1779354f3779ce89490fbe337d7788d6f35a5e52410e39cff1486442d2d48:"
        },
        {
          "resource": "repo://_tools/sync_dates.py#L110-L120",
          "version": "repo-lines-v1:sha256:5bab0657add45b9afcb0bf43e378f458e09a8e36fbb1710b95efcd36395823e5:"
        }
      ]
    },
    {
      "id": "claim_b0dee07bd5d342769bb4586d72b436fb",
      "statement": "Commits that touch only the date or date-modified lines are excluded from the definition of a content change, without which the script's own output would become the next run's evidence and push every date forward indefinitely.",
      "evidence": [
        {
          "resource": "repo://_tools/sync_dates.py#L49-L63",
          "version": "repo-lines-v1:sha256:a25506a9eeb18b72c499fe2885ffbb9d5ebd1de2cd8d6ad6ddb5b173b763afed:"
