    {
      "id": "claim_49c5dd5b40f84964828c70e43adffcb6",
      "statement": "The style check counts em dashes only on prose lines, excluding bullets, quotes, tables, headings, and fenced code, and subtracts one leading bold label per bullet line, so structural formatting is not charged against the prose quota.",
      "evidence": [
        {
          "resource": "repo://_tools/site_lint.py#L188-L212",
          "version": "repo-lines-v1:sha256:dc422b884794534e7c80c8f766f779f05a8225f9fdfd2411d6dbf551d6083bca:"
        }
      ]
    },
    {
      "id": "claim_bbcd855a756843e8ac78e7fa79004f34",
      "statement": "Two style quotas were deliberately removed rather than tuned — a 아니라 quota that could not separate dramatic contrast from factual statement, and a connective-comma quota whose stated justification had no traceable source — because a groundless quota was driving edits that worsened sentences.",
      "evidence": [
