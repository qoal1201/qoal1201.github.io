    {
      "id": "claim_698deb7496904ae2923e9b8e8d76e75c",
      "statement": "The lint's file set is restricted to Quarto markdown, so the published Jupyter notebook under foundations is rendered and deployed without any lint coverage at all, including its inline copy of a competition score.",
