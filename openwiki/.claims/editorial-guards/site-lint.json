        }
      ]
    },
    {
      "id": "claim_c26ff6ce75664168b0c71e59154f0de6",
      "statement": "site_lint.py exits non-zero only when errors are present; warnings are printed and ignored by the exit code, which is what lets the push gate block correctness failures without blocking style quotas.",
      "evidence": [
        {
          "resource": "repo://_tools/site_lint.py#L310-L317",
          "version": "repo-lines-v1:sha256:fd2af55f053e6a2950bc243f10ba270b741422cb4acca4d22ea6433b880f1930:"
        }
      ]
    },
    {
      "id": "claim_425d5d43d7d54b2a8649f0d3a7a88df3",
      "statement": "Status-line enforcement is keyed to a literal path list plus a glob over paper-reviews, with before-attention.qmd excluded because a foundational-concept article has no reading range for a status line to disclose.",
      "evidence": [
        {
          "resource": "repo://_tools/site_lint.py#L44-L58",
          "version": "repo-lines-v1:sha256:992279cd4a96a8ef8387929cf990869cd3477eac2d2f470075abb96ad8600183:"
        }
      ]
    },
    {
      "id": "claim_0e52d1e7986f40e1a1c1ec6a06fe0f37",
      "statement": "Several site_lint checks are keyed to literal filenames and stop checking silently when a target is renamed or deleted; the module records two such incidents where a check pointed at a file that no longer existed and therefore never ran.",
      "evidence": [
        {
          "resource": "repo://_tools/site_lint.py#L36-L58",
          "version": "repo-lines-v1:sha256:87df3676f41998d0368d5a8f678d74f2cab9653c5134771a47856bdd7a41d531:"
        }
