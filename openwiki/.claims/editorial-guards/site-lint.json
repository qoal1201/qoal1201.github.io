  "claims": [
    {
      "id": "claim_e6a9efc59e6944ba853568ee510d30ec",
      "statement": "site_lint.py builds its check set by globbing the repository root plus paper-reviews, experiments, and foundations for .qmd files, so the linted set is derived from directory layout rather than read from the _quarto.yml render list it is meant to mirror.",
      "evidence": [
        {
          "resource": "repo://_tools/site_lint.py#L27-L33",
          "version": "repo-lines-v1:sha256:e95882b7c7b76229285e6657099e7e9918bc4a5a59346242676d9bd3f98bebbe:"
        },
        {
